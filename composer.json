{
  "name": "supplycart/snapshot",
  "description": "Capture model state over time",
  "scripts": {
    "test": "@php vendor/bin/phpunit"
  },
  "require": {
    "php": "^8.5",
    "illuminate/database": "^13.0",
    "illuminate/queue": "^13.0",
    "illuminate/support": "^13.0"
  },
  "require-dev": {
    "orchestra/canvas": "^11.0",
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "Supplycart\\Snapshot\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Supplycart\\Snapshot\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Supplycart\\Snapshot\\SnapshotServiceProvider"
      ]
    }
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Azri Ismail",
      "email": "azri@supplycart.my"
    }
  ]
}
